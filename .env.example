# Key gọi Gemini API cho tính năng "Hỏi AI: Món ngon & Địa điểm hot".
# Lấy key miễn phí tại: https://aistudio.google.com/apikey
#
# Local dev: copy file này thành ".env.local" rồi điền key thật vào (file .env.local đã bị .gitignore, không bị commit).
# Production (Vercel): vào Project Settings -> Environment Variables -> thêm VITE_GEMINI_API_KEY với giá trị key thật.
#
# CẢNH BÁO: Vite nhúng biến VITE_* thẳng vào bundle JS khi build, nên bất kỳ ai
# mở DevTools/View Source trên site đều đọc được key này. Nên dùng key có giới
# hạn quota riêng trong Google AI Studio, không dùng key chính không giới hạn.
VITE_GEMINI_API_KEY=

# Key gọi OpenRouter (model DeepSeek) cho tính năng "🎒 AI gợi ý đồ" (packing checklist theo lịch trình + thời tiết).
# Lấy key tại: https://openrouter.ai/keys
#
# Cùng quy tắc như VITE_GEMINI_API_KEY ở trên: local dev dùng .env.local, production set trong Vercel
# Environment Variables. Key này cũng bị nhúng công khai vào bundle JS — nên gắn hạn mức chi tiêu
# (spending limit) cho key trong OpenRouter dashboard để tránh bị lạm dụng.
VITE_OPENROUTER_API_KEY=


# ===== PUSH NOTIFICATION (Web Push chuẩn + VAPID) =====
# Tạo cặp key 1 lần:  npx web-push generate-vapid-keys
# Public key -> VITE_PUSH_VAPID_KEY (client + server đều dùng, công khai được)
VITE_PUSH_VAPID_KEY=

# --- Chỉ dùng ở server (Vercel Functions), KHÔNG có tiền tố VITE_ nên không bị nhúng vào bundle ---
# Private key của cặp VAPID ở trên (BÍ MẬT, chọn Type: Secret trên Vercel)
VAPID_PRIVATE_KEY=
# (Tuỳ chọn) email liên hệ gửi kèm push, dạng mailto:
# VAPID_SUBJECT=mailto:ban@gmail.com
# Firebase project push -> Project settings -> Service accounts -> Generate new private key
# -> dán NGUYÊN nội dung file JSON (dùng Firestore để lưu các thiết bị đăng ký)
FIREBASE_PUSH_SERVICE_ACCOUNT=
# Chuỗi ngẫu nhiên bất kỳ, dùng để bảo vệ /api/push/cron (nhắc lịch trình)
CRON_SECRET=
# (Tuỳ chọn) Realtime DB của project dữ liệu chính, mặc định là trip-app-8e382
# MAIN_FIREBASE_DB_URL=
